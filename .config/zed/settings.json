// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"context_servers": {
  "arch-ops-server": {
   "enabled": true,
   "remote": false,
   "settings": {}
  }
 },
 "agent": {
  "tool_permissions": {
   "tools": {
    "save_file": {
     "always_allow": [
      {
       "pattern": "^/home/sasi/GameProjects/Langort/"
      }
     ]
    }
   }
  },
  "default_profile": "write",
  "default_model": {
   "provider": "ollama",
   "model": "qwen3.5:0.8b",
   "enable_thinking": false
  },
  "favorite_models": [],
  "model_parameters": []
 },
 "git_panel": {
  "status_style": "label_color"
 },
 "disable_ai": false,
 "format_on_save": "off",
 "git": {
		"inline_blame": {
			"enabled": false
		}
	},
	"project_panel": {
		"dock": "right"
	},
	"base_keymap": "VSCode",
	"gutter": {
		"line_numbers": true
	},
	"buffer_font_fallbacks": ["0xProto Nerd Font", ".ZedMono"],
	"buffer_font_family": "0xProto Nerd Font Mono",
	"tab_size": 4,
	"hard_tabs": false,
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"theme": {
		"mode": "dark",
		"light": "Zedokai Darker (Filter Octagon)",
		"dark": "Godot"
	},

	// git status.
 "tabs": {
   "file_icons": true,
   "git_status": true
 },
	"title_bar": {
		"show_user_picture": true,
		"show_branch_name": false,
		"show_project_items": false,
		"show_branch_icon": false
	},
 // Remove the < > buttons from the tab bar
   "tab_bar": {
     "show": true,
     "show_nav_history_buttons": false
   },
   // Enable Vim mode. You probably found this already if you care.
   "vim_mode": true,

   // Use relative line numbers.
   "relative_line_numbers": "enabled",

   // Scroll the whole view if your cursor is less than 20 horizontal lines
   // away from either part of your file viewport.
   "vertical_scroll_margin": 20
}
